#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import shlex
import sys
from pathlib import Path
from string import Template
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from dmpod_common import (  # noqa: E402
    atomic_json,
    atomic_write,
    file_sha256,
    load_environment_config,
    require_name,
)
from dmpod_report import (  # noqa: E402
    benchmark_sections,
    checkpoint_table,
    collect_wandb_media,
    generate_training_charts,
    load_metrics,
    media_markdown,
    model_card_front_matter,
    native_checkpoint_usage,
    public_report_value,
    table,
)


def load(path: Path, required: bool = True) -> Any:
    if not path.is_file():
        if required:
            raise FileNotFoundError(path)
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def unique(values: list[str]) -> list[str]:
    return list(dict.fromkeys(value for value in values if value))


def reproduce_commands(name: str, config: dict[str, Any]) -> str:
    profile = config.get("profile")
    commands: list[str] = []
    if profile and profile != "config":
        experiment = config.get("experiment")
        if not experiment:
            return (
                "# Legacy run: use the immutable files in report-context.json; new runs "
                "also require explicit experiment metadata."
            )
        command = [
            "dmpod-create-training",
            "--profile",
            str(profile),
            "--max-lr",
            str(config["optimizer"]["max_lr"]),
            "--seed",
            str(config["runtime"]["seed"]),
            "--experiment-revision",
            str(experiment["revision"]),
            "--change",
            str(experiment["change"]),
            "--hypothesis",
            str(experiment["hypothesis"]),
            "--wandb-project",
            str(config["wandb"]["project"]),
            "--wandb-group",
            str(config["wandb"]["group"]),
            "--wandb-run-name",
            str(config["wandb"]["run_name"]),
            "--wandb-job-type",
            str(config["wandb"]["job_type"]),
        ]
        for tag in config["wandb"]["tags"]:
            command.extend(("--wandb-tag", str(tag)))
        commands.append(shlex.join(command))
        commands.append(shlex.join(["dmpod-train", name, "--tmux"]))
    else:
        commands.extend(
            [
                "# Recreate the run from the immutable files listed in report-context.json.",
                shlex.join(["dmpod-train", name, "--resume", "--tmux"]),
            ]
        )
    return "\n".join(commands)


def main() -> None:
    parser = argparse.ArgumentParser(description="Export a trained run as Markdown.")
    parser.add_argument("name")
    parser.add_argument("--format", choices=("all", "readme", "pr"), default="all")
    parser.add_argument("--output-dir", type=Path)
    parser.add_argument("--model-id")
    parser.add_argument("--model-license")
    parser.add_argument("--language", action="append", default=[])
    parser.add_argument("--dataset-id", action="append", default=[])
    parser.add_argument("--tag", action="append", default=[])
    parser.add_argument(
        "--wandb-media-dir",
        action="append",
        default=[],
        type=Path,
        help="Directory containing W&B images downloaded for publication",
    )
    args = parser.parse_args()
    require_name(args.name, "run name")
    environment = load_environment_config()
    run_dir = Path(environment["runs_root"]) / args.name
    manifest = load(run_dir / "manifest.json")
    if manifest.get("schema") != "dmpod.run" or manifest.get("schema_version") != 1:
        raise ValueError("Unsupported run format; create a new DMPod run")
    config = load(run_dir / "config.json")
    if config.get("schema") != "dmpod.config" or config.get("schema_version") != 1:
        raise ValueError("Unsupported training configuration")
    summary = load(run_dir / "summary.json")
    state = load(run_dir / "state.json", required=False)
    runtime = load(run_dir / "runtime.json")
    artifacts = load(run_dir / "artifacts.json", required=False)
    wandb = load(run_dir / "wandb.json", required=False)
    benchmarks = load(run_dir / "benchmarks" / "results.json", required=False)
    output_dir = (args.output_dir or run_dir / "reports").resolve()
    output_dir.mkdir(parents=True, exist_ok=True)
    template_root = Path(__file__).resolve().parents[1] / "templates"
    publication = config.get("publication", {})
    model_name = args.model_id or args.name
    languages = unique([*publication.get("languages", []), *args.language])
    dataset_ids = unique([*publication.get("datasets", []), *args.dataset_id])
    publication_tags = unique(
        [
            *config.get("wandb", {}).get("tags", []),
            *publication.get("tags", []),
            *args.tag,
        ]
    )
    model_license = args.model_license or publication.get("model_license")
    metrics_path = run_dir / "metrics.jsonl"
    metrics = load_metrics(metrics_path)
    published_metrics_path = output_dir / "metrics.jsonl"
    if metrics_path.is_file():
        atomic_write(published_metrics_path, metrics_path.read_text(encoding="utf-8"))
    else:
        published_metrics_path.unlink(missing_ok=True)
    generated_charts = generate_training_charts(metrics, output_dir)
    wandb_media = collect_wandb_media(run_dir, output_dir, args.wandb_media_dir)
    media = [*generated_charts, *wandb_media]
    results = table(
        [
            ("Training status", summary["stop_reason"]),
            ("Target token budget completed", summary["completed_target_budget"]),
            ("Final validation loss", summary["final_val_loss"]),
            ("Minimum validation loss", summary["min_val_loss"]),
            ("Tokens at minimum", summary["tokens_at_min_val_loss"]),
            ("Final train-eval loss", summary["final_train_eval_loss"]),
            ("Final perplexity", summary["final_val_perplexity"]),
            ("Tokens seen", summary["final_tokens_seen"]),
            ("Data passes", summary["final_data_pass_equivalent"]),
            ("Optimizer updates", summary["optimizer_updates_completed"]),
            ("Skipped updates", summary["skipped_updates_total"]),
            ("Mean tokens/s", summary["mean_tokens_per_sec"]),
            ("Wall time hours", summary["wall_time_hours"]),
            ("Peak GPU memory allocated GiB", summary["peak_gpu_memory_allocated_gb"]),
            ("Peak GPU memory reserved GiB", summary["peak_gpu_memory_reserved_gb"]),
            ("Best checkpoint alias", summary["best_checkpoint_alias"]),
            ("Final checkpoint alias", summary["final_checkpoint_alias"]),
            ("Exit code", summary["exit_code"]),
        ]
    )
    model = config["model"]
    model_values = table(
        [
            ("Architecture", "decoder-only Transformer"),
            ("Objective", config["task"]["objective"]),
            ("Layers", model["n_layer"]),
            ("Heads", model["n_head"]),
            ("Embedding width", model["n_embd"]),
            ("Context length", model["block_size"]),
            ("Vocabulary", model["vocab_size"]),
            ("Dropout", model["dropout"]),
            ("Bias", model["bias"]),
            ("Weight tying", model["weight_tying"]),
            ("Target parameters", model["target_parameter_count"]),
            ("Total parameters", model["actual_parameters_total"]),
            ("Trainable parameters", model["actual_parameters_trainable"]),
            ("Non-embedding parameters", model["actual_parameters_non_embedding"]),
        ]
    )
    optimizer = config["optimizer"]
    batch = config["batch"]
    training = table(
        [
            ("Optimizer", optimizer["optimizer"]),
            ("Maximum LR", optimizer["max_lr"]),
            ("Minimum LR ratio", optimizer["min_lr_ratio"]),
            ("Minimum LR", optimizer["min_lr"]),
            ("LR schedule", optimizer["lr_schedule"]),
            ("Warmup ratio", optimizer["warmup_ratio"]),
            ("Warmup tokens", optimizer["warmup_tokens"]),
            ("LR decay end tokens", optimizer["lr_decay_end_tokens"]),
            ("Adam beta1", optimizer["adam_beta1"]),
            ("Adam beta2", optimizer["adam_beta2"]),
            ("Adam epsilon", optimizer["adam_eps"]),
            ("Weight decay", optimizer["weight_decay"]),
            ("Gradient clipping", optimizer["grad_clip"]),
        ]
    )
    batch_values = table(
        [
            ("Micro batch per GPU", batch["micro_batch_size_per_gpu"]),
            (
                "Global gradient accumulation",
                batch["global_gradient_accumulation_steps"],
            ),
            ("Effective batch tokens", batch["effective_batch_tokens"]),
            ("Target updates", batch["target_update_steps"]),
            ("Target train tokens", batch["target_train_tokens"]),
            ("Actual train tokens", batch["actual_train_tokens"]),
            ("Actual data passes", batch["actual_data_passes"]),
            (
                "Budget rounding",
                batch.get("budget_rounding", "configured update steps"),
            ),
        ]
    )
    execution = config["runtime"]
    runtime_values = table(
        [
            ("Seed", execution["seed"]),
            ("Data seed", execution["data_seed"]),
            ("Evaluation seed", execution["eval_seed"]),
            ("Precision", execution["precision"]),
            ("TF32", execution["allow_tf32"]),
            ("torch.compile", execution["torch_compile"]),
            ("Gradient checkpointing", execution["gradient_checkpointing"]),
            ("DDP backend", execution["ddp_backend"]),
            ("GPU", runtime["gpu_model"]),
            ("GPU count", runtime["gpu_count"]),
        ]
    )
    evaluation = config["evaluation"]
    evaluation_values = table(
        [
            ("Evaluate at start", evaluation["eval_at_start"]),
            ("Evaluate at warmup end", evaluation["eval_at_warmup_end"]),
            ("Evaluation interval tokens", evaluation["eval_interval_tokens"]),
            ("Evaluation data passes", evaluation["eval_at_data_passes"]),
            ("Final evaluation required", evaluation["final_eval_required"]),
            ("Validation mode", evaluation["val_evaluation_mode"]),
            ("Train-eval subset enabled", evaluation["train_eval_subset_enabled"]),
            ("Train-eval subset tokens", evaluation["train_eval_subset_tokens"]),
            ("Evaluation batch size", evaluation["eval_batch_size"]),
            ("Loss reduction", evaluation["loss_reduction"]),
        ]
    )
    checkpoint = config["checkpoint"]
    checkpoint_policy = table(
        [
            ("Maximum interval minutes", checkpoint["max_interval_minutes"]),
            ("Save latest", checkpoint["save_last_checkpoint"]),
            ("Save best validation", checkpoint["save_best_val_checkpoint"]),
            ("Save final", checkpoint["save_final_checkpoint"]),
            ("Save at data passes", checkpoint["save_at_data_passes"]),
            ("Upload retained checkpoints to W&B", checkpoint["log_wandb_artifacts"]),
        ]
    )
    logging = config["logging"]
    logging_values = table(
        [
            (
                "Target tokens per training log",
                logging["train_log_interval_target_tokens"],
            ),
            ("Training log interval steps", logging["train_log_interval_steps"]),
            (
                "Aggregate over logging window",
                logging["aggregate_metrics_over_logging_window"],
            ),
            ("Log from rank zero only", logging["log_from_rank_zero_only"]),
            (
                "Synchronize distributed metrics",
                logging["synchronize_distributed_metrics_before_logging"],
            ),
            (
                "Exclude evaluation from timing",
                logging["exclude_evaluation_from_step_timing"],
            ),
            (
                "Exclude checkpoints from timing",
                logging["exclude_checkpointing_from_step_timing"],
            ),
            (
                "Exclude W&B upload from timing",
                logging["exclude_wandb_upload_from_step_timing"],
            ),
        ]
    )
    wandb_config = config["wandb"]
    wandb_values = table(
        [
            ("Schema", wandb_config.get("schema", "legacy")),
            ("Project", wandb_config["project"]),
            ("Group", wandb_config["group"]),
            ("Job type", wandb_config["job_type"]),
            ("Run name", wandb_config.get("run_name", config["name"])),
            ("Run ID", wandb_config["run_id"]),
            ("Tags", wandb_config["tags"]),
            ("Primary x-axis", wandb_config["primary_x_axis"]),
            ("Primary comparison metric", wandb_config["primary_comparison_metric"]),
            ("Comparison goal", wandb_config["comparison_goal"]),
        ]
    )
    experiment = config.get("experiment")
    experiment_values = (
        table(
            [
                ("Schema", experiment.get("schema")),
                ("Revision", experiment.get("revision")),
                ("Change", experiment.get("change")),
                ("Hypothesis", experiment.get("hypothesis")),
            ]
        )
        if experiment
        else "Legacy run without structured experiment metadata."
    )
    dataset = config["dataset"]
    data = config["data"]
    data_values = table(
        [
            ("Dataset", dataset["name"]),
            ("Hugging Face dataset", dataset_ids),
            ("Revision", dataset["revision"]),
            ("License", dataset["license"]),
            ("Training tokens", data["train_tokens_unique"]),
            ("Validation tokens", data["val_tokens"]),
            ("Dataset size GiB", dataset["dataset_size_gib"]),
            ("Sampling", data["sampling_mode"]),
            ("Target data passes", data["target_data_passes"]),
            ("Train SHA-256", dataset["files"]["train"]["sha256"]),
            ("Validation SHA-256", dataset["files"]["val"]["sha256"]),
            ("Tokenizer", dataset["tokenizer"]["name"]),
            ("Tokenizer version", dataset["tokenizer"]["version"]),
            ("Tokenizer vocabulary", dataset["tokenizer"]["vocab_size"]),
            ("Tokenizer SHA-256", dataset["tokenizer"]["sha256"]),
            ("Document boundary token", dataset["document_boundary_token_id"]),
            ("Padding token", dataset["padding_token_id"]),
            ("Split", dataset["split_method"]),
            ("Deduplication", dataset["deduplication_method"]),
        ]
    )
    source = manifest.get("source", {"type": "unknown"})
    source_rows: list[tuple[str, Any]] = [("Initialization", source["type"])]
    if source["type"] == "hf":
        source_rows.extend(
            [
                (
                    "Base model",
                    "local directory"
                    if source.get("local")
                    else source.get("model_id"),
                ),
                ("Base-model revision", source.get("revision")),
                ("Base-model content SHA-256", source.get("content_sha256")),
            ]
        )
    elif source["type"] == "checkpoint":
        source_rows.append(
            ("Initialization checkpoint SHA-256", source.get("checkpoint_sha256"))
        )
    source_values = table(source_rows)
    provenance = table(
        [
            ("Run created", manifest["created_at"]),
            ("Training profile", config["profile"]),
            ("Git commit", manifest["git"]["commit"]),
            ("Git dirty", manifest["git"]["dirty"]),
            ("PyTorch", runtime["pytorch_version"]),
            ("CUDA", runtime["cuda_version"]),
            ("W&B", runtime["wandb_version"]),
            ("W&B run", wandb["url"] if wandb else "offline"),
        ]
    )
    checkpoints = checkpoint_table(artifacts)
    benchmark_table, benchmark_metrics, benchmark_links, benchmark_note = (
        benchmark_sections(benchmarks)
    )
    reproduce = reproduce_commands(args.name, config)
    completion_notice = (
        "The recorded run completed its configured token budget and final evaluation."
        if summary["completed_target_budget"] and summary["exit_code"] == 0
        else "> **Incomplete run:** review the stop reason and checkpoints before publishing."
    )
    if wandb and wandb.get("url"):
        wandb_section = (
            f"Training was tracked in [Weights & Biases]({wandb['url']}) "
            f"(`{wandb['entity']}/{wandb['project']}`, run `{wandb['run_id']}`)."
        )
    else:
        wandb_section = "This run was recorded without a public W&B run URL."
    license_section = (
        f"The model weights are released under `{model_license}`. Dataset and tokenizer "
        "licenses remain governed by their respective sources."
        if model_license
        else "> **Before public release:** choose and pass `--model-license`. A dataset "
        "license does not automatically grant or determine a license for model weights."
    )
    front_matter = model_card_front_matter(
        model_name=model_name,
        config=config,
        manifest=manifest,
        summary=summary,
        benchmarks=benchmarks,
        languages=languages,
        dataset_ids=dataset_ids,
        model_license=model_license,
        extra_tags=args.tag,
    )
    context = {
        "schema_version": 2,
        "run": config,
        "state": state,
        "summary": summary,
        "runtime": runtime,
        "manifest": manifest,
        "artifacts": artifacts,
        "wandb": wandb,
        "benchmarks": benchmarks,
        "publication": {
            "model_id": model_name,
            "model_license": model_license,
            "languages": languages,
            "datasets": dataset_ids,
            "tags": publication_tags,
        },
        "metrics": {
            "path": "metrics.jsonl",
            "records": len(metrics),
            "sha256": (
                file_sha256(published_metrics_path)
                if published_metrics_path.is_file()
                else None
            ),
        },
        "media": media,
    }
    atomic_json(
        output_dir / "report-context.json", public_report_value(context, run_dir)
    )
    if args.format in {"all", "readme"}:
        source = Template(
            (template_root / "model-readme.md").read_text(encoding="utf-8")
        )
        atomic_write(
            output_dir / "README.md",
            source.substitute(
                front_matter=front_matter,
                model_name=model_name,
                completion_notice=completion_notice,
                results_table=results,
                benchmark_table=benchmark_table,
                benchmark_metrics=benchmark_metrics,
                benchmark_links=benchmark_links,
                benchmark_note=benchmark_note,
                model_table=model_values,
                source_table=source_values,
                training_table=training,
                batch_table=batch_values,
                runtime_table=runtime_values,
                evaluation_table=evaluation_values,
                logging_table=logging_values,
                experiment_table=experiment_values,
                wandb_table=wandb_values,
                data_table=data_values,
                checkpoint_policy_table=checkpoint_policy,
                checkpoint_table=checkpoints,
                reproduce_command=reproduce,
                provenance_table=provenance,
                training_media=media_markdown(media),
                wandb_section=wandb_section,
                checkpoint_usage=native_checkpoint_usage(),
                license_section=license_section,
            )
            + "\n",
        )
    if args.format in {"all", "pr"}:
        source = Template(
            (template_root / "trained-model-pr.md").read_text(encoding="utf-8")
        )
        checklist = "\n".join(
            [
                f"- [{'x' if summary['completed_target_budget'] else ' '}] Target token budget completed",
                "- [x] Dataset and tokenizer hashes verified",
                "- [x] Immutable training configuration saved",
                f"- [{'x' if summary['final_val_loss'] is not None else ' '}] Final evaluation completed",
                f"- [{'x' if summary['final_checkpoint_alias'] else ' '}] Final checkpoint recorded",
                f"- [{'x' if benchmarks and benchmarks.get('results') and not benchmark_note else ' '}] Full quality benchmarks recorded",
                f"- [{'x' if model_license else ' '}] Model-weights license selected",
            ]
        )
        link = (
            f"[{wandb['url']}]({wandb['url']})"
            if wandb and wandb.get("url")
            else "offline"
        )
        atomic_write(
            output_dir / "PR_BODY.md",
            source.substitute(
                summary=f"Adds the trained checkpoint for `{args.name}`.",
                results_table=results,
                benchmark_table=benchmark_table,
                benchmark_links=benchmark_links,
                benchmark_note=benchmark_note,
                reproducibility_checklist=checklist,
                checkpoint_table=checkpoints,
                stop_reason=summary["stop_reason"],
                completed_target_budget=str(summary["completed_target_budget"]).lower(),
                wandb_link=link,
                manifest_path=str(run_dir / "manifest.json"),
            )
            + "\n",
        )
    print(f"Run reports written to {output_dir}")


if __name__ == "__main__":
    main()
