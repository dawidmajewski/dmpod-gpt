#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import os
import shutil
import subprocess
import sys
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from dmpod_common import (  # noqa: E402
    atomic_json,
    execute_configs,
    file_sha256,
    load_environment_config,
    load_json,
    project_root,
    require_name,
    tree_sha256,
    validate_dataset,
    validate_model_config,
)
from dmpod_profile import (  # noqa: E402
    canonical_run_name,
    ensure_dataset_manifest,
    load_profile,
    profile_from_configs,
    resolve_profile,
    validate_dataset_manifest,
    write_config,
    write_train_eval_offsets,
    write_val_eval_offsets,
)
from dmpod_wandb import configure_run  # noqa: E402


ARCHITECTURE_KEYS = ("n_layer", "n_head", "n_embd", "block_size", "bias")


def git_provenance(root: Path) -> dict[str, object]:
    revision = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "HEAD"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    status = subprocess.run(
        ["git", "-C", str(root), "status", "--porcelain=v1"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    return {
        "commit": revision,
        "dirty": bool(status),
        "status_sha256": hashlib.sha256(status.encode()).hexdigest(),
    }


def create_profile_run(args: argparse.Namespace) -> None:
    environment = load_environment_config()
    profile_path, profile = load_profile(args.profile)
    dataset_dir = (project_root() / profile["data"]["path"]).resolve()
    manifest_path = (
        args.dataset_manifest.expanduser().resolve()
        if args.dataset_manifest
        else dataset_dir / profile["data"]["manifest_file"]
    )
    if manifest_path.parent != dataset_dir:
        raise ValueError(f"Dataset manifest must be inside {dataset_dir}")
    dataset_manifest, dataset_validation = validate_dataset_manifest(
        manifest_path, profile
    )
    tokenizer_source = Path(dataset_validation["tokenizer"]["path"])
    resolved = resolve_profile(
        profile,
        max_lr=args.max_lr,
        seed=args.seed,
        dataset_validation=dataset_validation,
    )
    resolved["profile"] = profile["name"]
    configure_run(
        resolved,
        revision=args.experiment_revision,
        change=args.change,
        hypothesis=args.hypothesis,
        project=args.wandb_project,
        group=args.wandb_group,
        run_name=args.wandb_run_name,
        job_type=args.wandb_job_type,
        tags=args.wandb_tag,
    )
    generated_name = canonical_run_name(resolved)
    name = args.name or generated_name
    require_name(name, "run name")
    if args.name and args.name != generated_name:
        raise ValueError(
            f"Run name for this profile must be {generated_name!r}; omit NAME to generate it"
        )
    runs_root = Path(environment["runs_root"])
    run_dir = runs_root / name
    if run_dir.exists():
        raise FileExistsError(f"Run already exists: {run_dir}")

    runs_root.mkdir(parents=True, exist_ok=True)
    staging = runs_root / f".{name}.tmp.{os.getpid()}"
    if staging.exists():
        raise FileExistsError(f"Staging directory already exists: {staging}")
    staging.mkdir()
    try:
        for directory in ("checkpoints", "logs", "reports", "sources"):
            (staging / directory).mkdir()
        profile_copy = staging / "sources" / "profile.json"
        dataset_copy = staging / "sources" / "dataset.json"
        validation_copy = staging / "sources" / "dataset-validation.json"
        tokenizer_copy = staging / "sources" / "tokenizer.json"
        model_copy = staging / "sources" / "model.py"
        trainer_copy = staging / "sources" / "trainer.py"
        wandb_contract_copy = staging / "sources" / "dmpod_wandb.py"
        shutil.copy2(profile_path, profile_copy)
        atomic_json(dataset_copy, dataset_manifest)
        atomic_json(validation_copy, dataset_validation)
        shutil.copy2(tokenizer_source, tokenizer_copy)
        shutil.copy2(project_root() / "model.py", model_copy)
        shutil.copy2(
            Path(__file__).resolve().parents[1] / "lib" / "trainer.py",
            trainer_copy,
        )
        shutil.copy2(
            Path(__file__).resolve().parents[1] / "lib" / "dmpod_wandb.py",
            wandb_contract_copy,
        )

        resolved["name"] = name
        resolved["created_at"] = dt.datetime.now(dt.timezone.utc).isoformat()
        resolved["data"]["path"] = str(dataset_dir)
        resolved["dataset"]["tokenizer"]["path"] = str(
            run_dir / "sources" / "tokenizer.json"
        )
        resolved["wandb"]["run_id"] = uuid.uuid4().hex[:8]
        resolved["evaluation"]["train_eval_offsets"] = write_train_eval_offsets(
            staging, resolved
        )
        if resolved["evaluation"]["val_evaluation_mode"] == "fixed_subset":
            resolved["evaluation"]["val_eval_offsets"] = write_val_eval_offsets(
                staging, resolved
            )
        config_path = staging / "config.json"
        write_config(config_path, resolved)
        provenance = git_provenance(project_root())
        tracked = {
            "profile": profile_copy,
            "dataset_manifest": dataset_copy,
            "dataset_validation": validation_copy,
            "tokenizer": tokenizer_copy,
            "model_source": model_copy,
            "trainer_source": trainer_copy,
            "wandb_contract": wandb_contract_copy,
            "config": config_path,
            "train_eval_offsets": staging
            / resolved["evaluation"]["train_eval_offsets"]["path"],
        }
        if "val_eval_offsets" in resolved["evaluation"]:
            tracked["val_eval_offsets"] = (
                staging / resolved["evaluation"]["val_eval_offsets"]["path"]
            )
        run_manifest = {
            "schema": "dmpod.run",
            "schema_version": 1,
            "name": name,
            "created_at": resolved["created_at"],
            "profile": args.profile,
            "source": {"type": "scratch"},
            "dataset": dataset_validation,
            "git": provenance,
            "files": {
                key: {
                    "path": str(path.relative_to(staging)),
                    "sha256": file_sha256(path),
                }
                for key, path in tracked.items()
            },
        }
        atomic_json(staging / "manifest.json", run_manifest)
        os.replace(staging, run_dir)
    finally:
        if staging.exists():
            shutil.rmtree(staging)
    print(f"Training run created: {run_dir}")
    print(f"Start in tmux: dmpod-train {name} --tmux")
    print(f"Attach with: tmux attach -t dmpod-{name}")


def validate_checkpoint(
    path: Path, model: dict[str, object]
) -> tuple[int, dict[str, object]]:
    import torch

    checkpoint = torch.load(path, map_location="cpu", mmap=True, weights_only=False)
    if (
        checkpoint.get("schema") != "dmpod.checkpoint"
        or checkpoint.get("schema_version") != 1
    ):
        raise ValueError(f"Unsupported checkpoint format: {path}")
    for key in ("model", "model_args", "full_training_config", "tokenizer_reference"):
        if key not in checkpoint:
            raise ValueError(f"Checkpoint is missing {key!r}: {path}")
    checkpoint_model = checkpoint["model_args"]
    for key in ARCHITECTURE_KEYS:
        if checkpoint_model.get(key) != model[key]:
            raise ValueError(
                f"Checkpoint {key}={checkpoint_model.get(key)!r} does not match "
                f"model config {model[key]!r}"
            )
    vocab_size = checkpoint_model.get("vocab_size")
    if type(vocab_size) is not int or vocab_size < 1:
        raise ValueError(f"Checkpoint has an invalid vocab_size: {vocab_size!r}")
    tokenizer_reference = checkpoint["tokenizer_reference"]
    if not isinstance(tokenizer_reference, dict):
        raise ValueError(f"Checkpoint has an invalid tokenizer reference: {path}")
    return vocab_size, tokenizer_reference


def hf_reference(model_id: str) -> tuple[str, bool]:
    local = Path(model_id).expanduser()
    if local.exists():
        if not local.is_dir():
            raise ValueError(f"Local Hugging Face model is not a directory: {local}")
        return str(local.resolve()), True
    return model_id, False


def validate_hf(
    model_id: str,
    revision: str | None,
    cache_dir: Path,
    model: dict[str, object],
) -> tuple[str, bool, str | None, str | None, int]:
    from transformers import AutoConfig
    from huggingface_hub import model_info

    reference, local = hf_reference(model_id)
    if not local and not revision:
        raise ValueError("Remote Hugging Face models require --revision")
    resolved_revision = revision
    content_hash = None
    if local:
        content_hash = tree_sha256(Path(reference))
    else:
        resolved_revision = model_info(model_id, revision=revision).sha
        if not resolved_revision:
            raise ValueError("Hugging Face did not return an immutable commit revision")
    config = AutoConfig.from_pretrained(
        reference,
        revision=resolved_revision,
        cache_dir=cache_dir,
        trust_remote_code=False,
    )
    if config.model_type != "gpt2":
        raise ValueError(
            f"Only GPT-2-compatible Hugging Face models are supported, got "
            f"{config.model_type!r}"
        )
    if model["bias"] is not True:
        raise ValueError("Exact GPT-2 Hugging Face import requires bias=True")
    expected = {
        "n_layer": int(config.n_layer),
        "n_head": int(config.n_head),
        "n_embd": int(config.n_embd),
        "block_size": int(config.n_positions),
    }
    for key, value in expected.items():
        if model[key] != value:
            raise ValueError(
                f"Hugging Face {key}={value} does not match model config {model[key]}"
            )
    return reference, local, resolved_revision, content_hash, int(config.vocab_size)


def create_config_run(args: argparse.Namespace) -> None:
    if not args.name:
        raise ValueError("Config-based runs require NAME")
    if not args.model_config or not args.training_config or not args.source:
        raise ValueError(
            "Config-based runs require --model-config, --training-config, and --source"
        )
    require_name(args.name, "run name")
    environment = load_environment_config()
    model_path = args.model_config.expanduser().resolve()
    training_path = args.training_config.expanduser().resolve()
    for path in (model_path, training_path):
        if not path.is_file():
            raise FileNotFoundError(path)

    model_values = execute_configs([model_path])
    validate_model_config(model_values)
    training_values = execute_configs([training_path])
    overlap = sorted(set(ARCHITECTURE_KEYS) & training_values.keys())
    if overlap:
        raise ValueError(
            "Training config must not redefine model architecture: "
            + ", ".join(overlap)
        )
    effective = execute_configs([model_path, training_path])
    dataset_name = effective.get("dataset")
    if not isinstance(dataset_name, str) or not dataset_name:
        raise ValueError("Training config must define a dataset string")
    dataset_dir = project_root() / "data" / dataset_name
    validate_dataset(dataset_dir, block_size=int(model_values["block_size"]))
    dataset_manifest_path = ensure_dataset_manifest(dataset_dir, dataset_name)
    dataset_manifest = load_json(dataset_manifest_path)

    source: dict[str, object] = {"type": args.source}
    if args.source == "scratch":
        if args.model_id or args.revision or args.checkpoint:
            raise ValueError(
                "scratch source does not accept model or checkpoint arguments"
            )
        tokenizer = dataset_manifest["tokenizer"]
        vocab_size = int(tokenizer.get("model_vocab_size", tokenizer["vocab_size"]))
    elif args.source == "hf":
        if not args.model_id or args.checkpoint:
            raise ValueError(
                "hf source requires --model-id and does not accept --checkpoint"
            )
        reference, local, resolved_revision, content_hash, vocab_size = validate_hf(
            args.model_id,
            args.revision,
            Path(environment["hf_cache"]),
            model_values,
        )
        source.update(
            model_id=reference,
            revision=resolved_revision,
            requested_revision=args.revision,
            local=local,
            content_sha256=content_hash,
            vocab_size=vocab_size,
        )
    else:
        if not args.checkpoint or args.model_id or args.revision:
            raise ValueError(
                "checkpoint source requires --checkpoint and does not accept HF arguments"
            )
        checkpoint = args.checkpoint.expanduser().resolve()
        if not checkpoint.is_file():
            raise FileNotFoundError(checkpoint)
        vocab_size, checkpoint_tokenizer = validate_checkpoint(checkpoint, model_values)
        if checkpoint_tokenizer.get("sha256") != dataset_manifest["tokenizer"].get(
            "sha256"
        ):
            raise ValueError(
                "Checkpoint tokenizer does not match the dataset tokenizer"
            )
        source.update(
            checkpoint=str(checkpoint),
            checkpoint_sha256=file_sha256(checkpoint),
            vocab_size=vocab_size,
        )

    if (
        args.source == "hf"
        and dataset_manifest["tokenizer"].get("name") != "tiktoken:gpt2"
    ):
        raise ValueError("GPT-2 Hugging Face initialization requires a GPT-2 tokenizer")

    profile = profile_from_configs(
        name=args.name,
        model_values=model_values,
        training_values=training_values,
        dataset_dir=dataset_dir,
        dataset_name=dataset_name,
        vocab_size=vocab_size,
    )
    _, dataset_validation = validate_dataset_manifest(dataset_manifest_path, profile)
    tokenizer_source = Path(dataset_validation["tokenizer"]["path"])
    resolved = resolve_profile(
        profile,
        max_lr=None,
        seed=None,
        dataset_validation=dataset_validation,
    )
    resolved["profile"] = "config"
    resolved["name"] = args.name
    resolved["created_at"] = dt.datetime.now(dt.timezone.utc).isoformat()
    configure_run(
        resolved,
        revision=args.experiment_revision,
        change=args.change,
        hypothesis=args.hypothesis,
        project=args.wandb_project,
        group=args.wandb_group,
        run_name=args.wandb_run_name,
        job_type=args.wandb_job_type,
        tags=args.wandb_tag,
    )
    resolved["wandb"]["run_id"] = uuid.uuid4().hex[:8]

    runs_root = Path(environment["runs_root"])
    run_dir = runs_root / args.name
    if run_dir.exists():
        raise FileExistsError(f"Run already exists: {run_dir}")
    resolved["dataset"]["tokenizer"]["path"] = str(
        run_dir / "sources" / "tokenizer.json"
    )
    runs_root.mkdir(parents=True, exist_ok=True)
    staging = runs_root / f".{args.name}.tmp.{os.getpid()}"
    if staging.exists():
        raise FileExistsError(f"Staging directory already exists: {staging}")
    staging.mkdir()
    try:
        for directory in ("checkpoints", "logs", "reports", "sources"):
            (staging / directory).mkdir()
        profile_copy = staging / "sources" / "profile.json"
        model_config_copy = staging / "sources" / "model-config.py"
        training_config_copy = staging / "sources" / "training-config.py"
        dataset_copy = staging / "sources" / "dataset.json"
        validation_copy = staging / "sources" / "dataset-validation.json"
        tokenizer_copy = staging / "sources" / "tokenizer.json"
        model_copy = staging / "sources" / "model.py"
        trainer_copy = staging / "sources" / "trainer.py"
        wandb_contract_copy = staging / "sources" / "dmpod_wandb.py"
        atomic_json(profile_copy, profile)
        shutil.copy2(model_path, model_config_copy)
        shutil.copy2(training_path, training_config_copy)
        atomic_json(dataset_copy, dataset_manifest)
        atomic_json(validation_copy, dataset_validation)
        shutil.copy2(tokenizer_source, tokenizer_copy)
        shutil.copy2(project_root() / "model.py", model_copy)
        shutil.copy2(
            Path(__file__).resolve().parents[1] / "lib" / "trainer.py",
            trainer_copy,
        )
        shutil.copy2(
            Path(__file__).resolve().parents[1] / "lib" / "dmpod_wandb.py",
            wandb_contract_copy,
        )
        resolved["evaluation"]["train_eval_offsets"] = write_train_eval_offsets(
            staging, resolved
        )
        if resolved["evaluation"]["val_evaluation_mode"] == "fixed_subset":
            resolved["evaluation"]["val_eval_offsets"] = write_val_eval_offsets(
                staging, resolved
            )
        config_path = staging / "config.json"
        write_config(config_path, resolved)
        provenance = git_provenance(project_root())
        tracked = {
            "profile": profile_copy,
            "model_config": model_config_copy,
            "training_config": training_config_copy,
            "dataset_manifest": dataset_copy,
            "dataset_validation": validation_copy,
            "tokenizer": tokenizer_copy,
            "model_source": model_copy,
            "trainer_source": trainer_copy,
            "wandb_contract": wandb_contract_copy,
            "config": config_path,
            "train_eval_offsets": staging
            / resolved["evaluation"]["train_eval_offsets"]["path"],
        }
        if "val_eval_offsets" in resolved["evaluation"]:
            tracked["val_eval_offsets"] = (
                staging / resolved["evaluation"]["val_eval_offsets"]["path"]
            )
        run_manifest = {
            "schema": "dmpod.run",
            "schema_version": 1,
            "name": args.name,
            "created_at": resolved["created_at"],
            "profile": "config",
            "source": source,
            "dataset": dataset_validation,
            "git": provenance,
            "files": {
                key: {
                    "path": str(path.relative_to(staging)),
                    "sha256": file_sha256(path),
                }
                for key, path in tracked.items()
            },
        }
        atomic_json(staging / "manifest.json", run_manifest)
        os.replace(staging, run_dir)
    finally:
        if staging.exists():
            shutil.rmtree(staging)
    print(f"Training run created: {run_dir}")
    print(f"Start in tmux: dmpod-train {args.name} --tmux")
    print(f"Attach with: tmux attach -t dmpod-{args.name}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Create an immutable DMPod training run."
    )
    parser.add_argument("name", nargs="?")
    parser.add_argument("--profile")
    parser.add_argument("--max-lr", type=float)
    parser.add_argument("--seed", type=int)
    parser.add_argument("--dataset-manifest", type=Path)
    parser.add_argument("--model-config", type=Path)
    parser.add_argument("--training-config", type=Path)
    parser.add_argument("--source", choices=("scratch", "hf", "checkpoint"))
    parser.add_argument("--model-id")
    parser.add_argument("--revision")
    parser.add_argument("--checkpoint", type=Path)
    parser.add_argument("--experiment-revision", required=True)
    parser.add_argument("--change", required=True)
    parser.add_argument("--hypothesis", required=True)
    parser.add_argument("--wandb-project")
    parser.add_argument("--wandb-group")
    parser.add_argument("--wandb-run-name")
    parser.add_argument("--wandb-job-type")
    parser.add_argument("--wandb-tag", action="append", default=[])
    args = parser.parse_args()

    if args.profile:
        if any(
            value is not None
            for value in (
                args.model_config,
                args.training_config,
                args.source,
                args.model_id,
                args.revision,
                args.checkpoint,
            )
        ):
            raise ValueError(
                "--profile cannot be combined with config-based run arguments"
            )
        create_profile_run(args)
        return

    if args.max_lr is not None or args.seed is not None or args.dataset_manifest:
        raise ValueError("Profile overrides require --profile")
    create_config_run(args)


if __name__ == "__main__":
    main()
