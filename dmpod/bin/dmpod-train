#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import importlib.metadata
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from dmpod_common import (  # noqa: E402
    atomic_json,
    file_sha256,
    load_environment_config,
    load_json,
    project_root,
    require_name,
    tree_sha256,
    verify_configured_wandb,
)
from dmpod_profile import validate_dataset_manifest  # noqa: E402
from import_hf import import_hf_weights  # noqa: E402


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def checkpoint_storage_preflight(run_dir: Path, config: dict[str, Any]) -> None:
    checkpoint = config["checkpoint"]
    parameters = int(config["model"]["actual_parameters_trainable"])
    estimated_checkpoint_bytes = int(parameters * 12 * 1.1)
    retained = {"ckpt-last.pt"}
    if checkpoint["save_best_val_checkpoint"]:
        retained.add("ckpt-best-val.pt")
    if checkpoint["save_final_checkpoint"]:
        retained.add("ckpt-final.pt")
    retained.update(
        f"ckpt-pass-{format(float(value), 'g')}.pt"
        for value in checkpoint["save_at_data_passes"]
    )
    expected_bytes = estimated_checkpoint_bytes * len(retained)
    checkpoint_dir = run_dir / "checkpoints"
    existing_bytes = sum(
        (checkpoint_dir / name).stat().st_size
        for name in retained
        if (checkpoint_dir / name).is_file()
    )
    additional_bytes = max(0, expected_bytes - existing_bytes)
    free_bytes = shutil.disk_usage(run_dir).free
    gib = 1024**3
    message = (
        f"Checkpoint storage estimate: {expected_bytes / gib:.1f} GiB retained; "
        f"{free_bytes / gib:.1f} GiB currently free"
    )
    if free_bytes < additional_bytes + estimated_checkpoint_bytes:
        print(f"Warning: {message}", file=sys.stderr, flush=True)
    else:
        print(message, flush=True)


def launch_tmux(args: argparse.Namespace, run_dir: Path) -> None:
    session = f"dmpod-{args.name}"
    if os.environ.get("TMUX"):
        raise RuntimeError("Already inside tmux; omit --tmux")
    existing = subprocess.run(
        ["tmux", "has-session", "-t", session],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if existing.returncode == 0:
        raise RuntimeError(f"tmux session already exists: {session}")
    command = [str(Path(__file__).resolve()), args.name]
    if args.resume:
        command.append("--resume")
    elif args.restart:
        command.append("--restart")
    if args.dry_run:
        command.append("--dry-run")
    log_path = run_dir / "logs" / "training.log"
    training_command = (
        "set -o pipefail; "
        f"cd {shlex.quote(str(project_root()))} && "
        f"PYTHONUNBUFFERED=1 {shlex.join(command)} 2>&1 | "
        f"tee -a {shlex.quote(str(log_path))}"
    )
    shell_command = f"exec bash -lc {shlex.quote(training_command)}"
    subprocess.run(
        ["tmux", "new-session", "-d", "-s", session, shell_command],
        check=True,
    )
    print(f"Training started in tmux session: {session}")
    print(f"Attach with: tmux attach -t {session}")
    print(f"Follow logs: tail -f {log_path}")


def runtime_metadata(manifest: dict[str, object], gpu_count: int) -> dict[str, object]:
    import torch

    test_gpu = os.environ.get("DMPOD_TEST_GPU_NAME")
    return {
        "gpu_model": (
            [test_gpu for _ in range(gpu_count)]
            if test_gpu
            else [torch.cuda.get_device_name(index) for index in range(gpu_count)]
        ),
        "gpu_count": gpu_count,
        "cuda_version": torch.version.cuda,
        "pytorch_version": torch.__version__,
        "wandb_version": os.environ.get("DMPOD_TEST_WANDB_VERSION")
        or importlib.metadata.version("wandb"),
        "git_commit": manifest["git"]["commit"],
        "git_dirty": manifest["git"]["dirty"],
    }


def run_training(
    args: argparse.Namespace,
    environment: dict[str, object],
    run_dir: Path,
    manifest: dict[str, object],
) -> None:
    for name, info in manifest["files"].items():
        path = run_dir / info["path"]
        if not path.is_file() or file_sha256(path) != info["sha256"]:
            raise RuntimeError(f"Immutable run file changed: {name} ({path})")
    profile = json.loads(
        (run_dir / manifest["files"]["profile"]["path"]).read_text(encoding="utf-8")
    )
    dataset_manifest_path = Path(manifest["dataset"]["manifest_path"])
    _, current_validation = validate_dataset_manifest(dataset_manifest_path, profile)
    for split in ("train", "val"):
        if (
            current_validation["files"][split]["sha256"]
            != manifest["dataset"]["files"][split]["sha256"]
        ):
            raise RuntimeError(f"Dataset {split} changed after run creation")
    if (
        current_validation["tokenizer"]["sha256"]
        != manifest["dataset"]["tokenizer"]["sha256"]
    ):
        raise RuntimeError("Tokenizer changed after run creation")

    config = load_json(run_dir / "config.json")
    if (
        config.get("schema") != "dmpod.config"
        or config.get("schema_version") != 1
    ):
        raise ValueError(
            f"Unsupported training configuration: {run_dir / 'config.json'}"
        )
    checkpoint_storage_preflight(run_dir, config)
    checkpoint = run_dir / "checkpoints" / "ckpt-last.pt"
    state_path = run_dir / "state.json"
    previous_state = load_json(state_path) if state_path.is_file() else None
    if previous_state is not None and (
        previous_state.get("schema") != "dmpod.run-state"
        or previous_state.get("schema_version") != 1
    ):
        raise ValueError(f"Unsupported run state format: {state_path}")
    source = manifest["source"]
    initialization_path: Path | None = None
    if args.resume:
        if not checkpoint.is_file():
            raise FileNotFoundError(f"Cannot resume without {checkpoint}")
        resume = True
    elif args.restart:
        if previous_state is None:
            raise RuntimeError("Run has not started; --restart is unnecessary")
        if checkpoint.exists():
            raise RuntimeError("Checkpoint exists; use --resume instead of --restart")
        resume = False
    elif previous_state is not None:
        raise RuntimeError(
            f"Run {args.name} has already started; use --resume or --restart explicitly"
        )
    else:
        resume = False
    if not resume and source["type"] == "checkpoint":
        initialization_path = Path(source["checkpoint"])
        if not initialization_path.is_file():
            raise FileNotFoundError(initialization_path)
        if file_sha256(initialization_path) != source["checkpoint_sha256"]:
            raise RuntimeError("Source checkpoint changed after run creation")
    elif not resume and source["type"] == "hf":
        if source.get("local") and tree_sha256(Path(source["model_id"])) != source.get(
            "content_sha256"
        ):
            raise RuntimeError("Local Hugging Face model changed after run creation")
        initialization_path = run_dir / "checkpoints" / ".initial-weights.pt"

    configured_gpu_count = os.environ.get("DMPOD_GPU_COUNT")
    if configured_gpu_count is not None:
        gpu_count = int(configured_gpu_count)
    else:
        import torch

        gpu_count = torch.cuda.device_count()
    if gpu_count < 1:
        raise RuntimeError("No CUDA GPUs are visible")
    global_accumulation = int(
        config["batch"]["global_gradient_accumulation_steps"]
    )
    if global_accumulation % gpu_count:
        raise ValueError(
            "global_gradient_accumulation_steps is not divisible by visible GPUs"
        )

    wandb = environment["wandb"]
    if wandb["mode"] == "disabled" or not wandb["enabled"]:
        raise RuntimeError(
            "DMPod runs require W&B online or explicit offline mode; rerun dmpod-setup"
        )
    os.environ["WANDB_MODE"] = wandb["mode"]
    os.environ["WANDB_DIR"] = str(run_dir / "logs" / "wandb")
    if wandb.get("entity"):
        os.environ["WANDB_ENTITY"] = wandb["entity"]
    if wandb["mode"] == "online":
        verify_configured_wandb(wandb)
    os.environ["DMPOD_WANDB_ENABLED"] = "1"
    runtime = runtime_metadata(manifest, gpu_count)
    atomic_json(run_dir / "runtime.json", runtime)
    trainer = run_dir / manifest["files"]["trainer_source"]["path"]
    trainer_args = [str(trainer), "--run-dir", str(run_dir)]
    if resume:
        trainer_args.append("--resume")
    elif initialization_path is not None:
        trainer_args.extend(("--init-from", str(initialization_path)))
    if gpu_count == 1:
        command = [sys.executable, *trainer_args]
    else:
        command = [
            "torchrun",
            "--standalone",
            f"--nproc_per_node={gpu_count}",
            *trainer_args,
        ]
    print("Training command:", shlex.join(command), flush=True)
    if args.dry_run:
        return
    attempts = int(previous_state.get("attempts", 0)) + 1 if previous_state else 1
    state = {
        "schema": "dmpod.run-state",
        "schema_version": 1,
        "status": "running",
        "attempts": attempts,
        "started_at": now(),
        "resume": resume,
        "gpu_count": gpu_count,
    }
    atomic_json(state_path, state)
    process: subprocess.Popen[Any] | None = None
    previous_signal_handlers: dict[int, Any] = {}

    def relay_signal(signum: int, _frame: Any) -> None:
        if process is None or process.poll() is not None:
            return
        try:
            process.send_signal(signum)
        except ProcessLookupError:
            pass

    try:
        if source["type"] == "hf" and initialization_path is not None:
            initialization_path.unlink(missing_ok=True)
            import_hf_weights(
                nanogpt_root=run_dir / "sources",
                model_id=source["model_id"],
                revision=source.get("revision"),
                output=initialization_path,
                model_config=config["model"],
                cache_dir=Path(environment["hf_cache"]),
            )
        for signum in (signal.SIGINT, signal.SIGTERM):
            previous_signal_handlers[signum] = signal.signal(signum, relay_signal)
        process = subprocess.Popen(command, cwd=project_root())
        returncode = process.wait()
    except BaseException as error:
        state.update(status="failed", finished_at=now(), error=type(error).__name__)
        atomic_json(state_path, state)
        raise
    finally:
        for signum, handler in previous_signal_handlers.items():
            signal.signal(signum, handler)
        if source["type"] == "hf" and initialization_path is not None:
            initialization_path.unlink(missing_ok=True)
    stop_reason = None
    summary_path = run_dir / "summary.json"
    if returncode == 0 and summary_path.is_file():
        stop_reason = load_json(summary_path).get("stop_reason")
    if returncode != 0:
        status = "failed"
    elif stop_reason in {"manual", "preempted"}:
        status = "stopped"
    else:
        status = "completed"
    state.update(
        status=status,
        finished_at=now(),
        exit_code=returncode,
        stop_reason=stop_reason,
    )
    atomic_json(state_path, state)
    raise SystemExit(returncode)


def main() -> None:
    parser = argparse.ArgumentParser(description="Launch a saved DMPod training run.")
    parser.add_argument("name")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--resume", action="store_true")
    mode.add_argument("--restart", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--tmux", action="store_true")
    args = parser.parse_args()

    require_name(args.name, "run name")
    environment = load_environment_config()
    run_dir = Path(environment["runs_root"]) / args.name
    manifest_path = run_dir / "manifest.json"
    if not manifest_path.is_file():
        raise FileNotFoundError(f"Unknown training run: {run_dir}")
    if args.tmux:
        launch_tmux(args, run_dir)
        return
    lock = (run_dir / ".train.lock").open("w", encoding="utf-8")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        raise RuntimeError(f"Training run is already active: {args.name}") from error
    manifest = load_json(manifest_path)
    if (
        manifest.get("schema") != "dmpod.run"
        or manifest.get("schema_version") != 1
    ):
        raise ValueError(
            f"Run {args.name} uses an unsupported format; create a new DMPod run"
        )
    run_training(args, environment, run_dir, manifest)


if __name__ == "__main__":
    main()
