#!/usr/bin/env python3
from __future__ import annotations

import argparse
import getpass
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from dmpod_common import (  # noqa: E402
    atomic_write,
    config_path,
    load_environment_config,
    project_root,
    state_root,
    verify_wandb_key,
    workspace_root,
    write_environment_config,
)


def confirm(prompt: str, default: bool = False) -> bool:
    suffix = " [Y/n] " if default else " [y/N] "
    answer = input(prompt + suffix).strip().lower()
    if not answer:
        return default
    return answer in {"y", "yes"}


def configure_huggingface(token: str, save: bool) -> str:
    from huggingface_hub import HfApi, login

    try:
        account = HfApi(token=token).whoami()
        if save:
            login(token=token, add_to_git_credential=False, skip_if_logged_in=False)
    except Exception as error:
        raise SystemExit(
            "Hugging Face rejected the configured token; create a current personal "
            "token at https://huggingface.co/settings/tokens and rerun dmpod-setup"
        ) from error
    username = account.get("name")
    if not username:
        raise SystemExit("Hugging Face did not return a username for this account")
    return str(username)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "Configure DMPod storage, caches, and optional W&B and Hugging Face access."
        )
    )
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--skip-wandb", action="store_true")
    group.add_argument("--wandb-from-env", action="store_true")
    hf_group = parser.add_mutually_exclusive_group()
    hf_group.add_argument("--skip-hf", action="store_true")
    hf_group.add_argument("--hf-from-env", action="store_true")
    parser.add_argument("--save-hf-token", action="store_true")
    parser.add_argument("--save-wandb-key", action="store_true")
    parser.add_argument("--wandb-project")
    parser.add_argument("--wandb-entity")
    parser.add_argument("--wandb-mode", choices=("online", "offline", "disabled"))
    parser.add_argument(
        "--project-root",
        help="Path to a nanoGPT-compatible project (default: /workspace/nanogpt)",
    )
    parser.add_argument("--non-interactive", action="store_true")
    args = parser.parse_args()
    if args.skip_hf and args.save_hf_token:
        parser.error("--save-hf-token cannot be combined with --skip-hf")

    existing = load_environment_config(required=False)
    existing_wandb = existing.get("wandb", {})
    root = workspace_root()
    selected_project_root = (
        Path(args.project_root).expanduser().resolve()
        if args.project_root
        else project_root()
    )
    if not selected_project_root.is_dir():
        raise SystemExit(f"Project root does not exist: {selected_project_root}")
    missing_project_files = [
        name
        for name in ("model.py", "train.py")
        if not (selected_project_root / name).is_file()
    ]
    if missing_project_files:
        raise SystemExit(
            f"Project root is not nanoGPT-compatible: {selected_project_root}; "
            f"missing {', '.join(missing_project_files)}"
        )
    paths = {
        "datasets_root": root / "datasets",
        "models_root": root / "models",
        "runs_root": root / "runs",
        "hf_cache": root / "cache" / "huggingface",
    }
    for path in (*paths.values(), root / "logs" / "wandb", state_root() / "secrets"):
        path.mkdir(parents=True, exist_ok=True)

    project = args.wandb_project or existing_wandb.get("project", "nanogpt-training")
    entity = args.wandb_entity
    if entity is None:
        entity = existing_wandb.get("entity", "")
    mode = args.wandb_mode or existing_wandb.get("mode", "online")
    key_source = "none"
    enabled = not args.skip_wandb and mode != "disabled"
    provided_key = ""
    key_path_to_write: Path | None = None

    if args.skip_wandb:
        mode = "disabled"
    elif args.wandb_from_env:
        if not os.environ.get("WANDB_API_KEY"):
            raise SystemExit("WANDB_API_KEY is not set")
        key_source = "environment"
        if args.save_wandb_key:
            provided_key = os.environ["WANDB_API_KEY"]
    elif os.environ.get("WANDB_API_KEY"):
        key_source = "environment"
        if args.save_wandb_key:
            provided_key = os.environ["WANDB_API_KEY"]
    elif existing_wandb.get("key_source") in {"workspace", "ephemeral"}:
        existing_key_source = existing_wandb["key_source"]
        existing_key_path = {
            "workspace": state_root() / "secrets" / "wandb.key",
            "ephemeral": Path.home() / ".config" / "dmpod" / "wandb.key",
        }[existing_key_source]
        if existing_key_path.is_file():
            key_source = existing_key_source
        elif mode not in {"offline", "disabled"} and args.non_interactive:
            raise SystemExit(f"Configured W&B key is missing: {existing_key_path}")
    elif mode in {"offline", "disabled"}:
        enabled = mode != "disabled"
    elif args.non_interactive:
        raise SystemExit("Use --wandb-from-env or --skip-wandb in non-interactive mode")
    else:
        enabled = confirm("Configure Weights & Biases?", default=True)
        if enabled:
            provided_key = getpass.getpass(
                "WANDB_API_KEY (hidden, press Enter to use offline mode): "
            ).strip()
            if not provided_key:
                mode = "offline"
                key_source = "none"
        else:
            mode = "disabled"

    if provided_key:
        save_persistent = args.save_wandb_key
        if not args.non_interactive and not args.save_wandb_key:
            save_persistent = confirm(
                "Save the key on /workspace for future Pods?", default=False
            )
        if save_persistent:
            key_path = state_root() / "secrets" / "wandb.key"
            key_source = "workspace"
        else:
            key_path = Path.home() / ".config" / "dmpod" / "wandb.key"
            key_source = "ephemeral"
        key_path_to_write = key_path

    if enabled and mode == "online":
        if provided_key:
            key_to_verify = provided_key
        elif os.environ.get("WANDB_API_KEY"):
            key_to_verify = os.environ["WANDB_API_KEY"]
        else:
            existing_key_path = {
                "workspace": state_root() / "secrets" / "wandb.key",
                "ephemeral": Path.home() / ".config" / "dmpod" / "wandb.key",
            }.get(key_source)
            key_to_verify = (
                existing_key_path.read_text(encoding="utf-8").strip()
                if existing_key_path and existing_key_path.is_file()
                else ""
            )
        if not key_to_verify:
            raise SystemExit("W&B online mode requires a non-empty API key")
        try:
            default_entity = verify_wandb_key(key_to_verify)
        except RuntimeError as error:
            raise SystemExit(
                "W&B rejected the configured API key or could not be reached; "
                "check connectivity and the key at https://wandb.ai/authorize, "
                "then rerun dmpod-setup"
            ) from error
        if not entity:
            entity = default_entity
    if key_path_to_write is not None:
        atomic_write(key_path_to_write, provided_key + "\n", mode=0o600)

    hf_username = ""
    hf_source = "none"
    hf_saved = False
    if not args.skip_hf:
        from huggingface_hub import get_token

        hf_token = ""
        if args.hf_from_env:
            hf_token = os.environ.get("HF_TOKEN", "")
            if not hf_token:
                raise SystemExit("HF_TOKEN is not set")
            hf_source = "environment"
        elif os.environ.get("HF_TOKEN"):
            hf_token = os.environ["HF_TOKEN"]
            hf_source = "environment"
        elif cached_token := get_token():
            hf_token = cached_token
            hf_source = "cached"
        elif not args.non_interactive and confirm(
            "Configure Hugging Face?", default=True
        ):
            hf_token = getpass.getpass(
                "HF_TOKEN (hidden, press Enter to skip): "
            ).strip()
            if hf_token:
                hf_source = "interactive"
        if hf_token:
            hf_saved = hf_source == "interactive" or args.save_hf_token
            hf_username = configure_huggingface(hf_token, save=hf_saved)

    config = {
        "version": 2,
        "workspace_root": str(root),
        "project_root": str(selected_project_root),
        **{name: str(path) for name, path in paths.items()},
        "wandb": {
            "enabled": enabled and mode != "disabled",
            "mode": mode,
            "project": project,
            "entity": entity,
            "key_source": key_source,
        },
    }
    write_environment_config(config)
    print(f"DMPod environment configured: {config_path()}")
    print(f"nanoGPT-compatible project: {selected_project_root}")
    print(f"W&B mode: {mode}; key source: {key_source}")
    if hf_username:
        persistence = "saved" if hf_saved else "not saved"
        print(
            f"Hugging Face: connected as {hf_username}; token source: {hf_source}; "
            f"{persistence}"
        )
    else:
        print("Hugging Face: not configured")


if __name__ == "__main__":
    main()
