#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from dmpod_common import atomic_json, export_wandb_key, load_environment_config  # noqa: E402


RUN_NAME = "lr-0.001_seed-1337_btok-8192"
TRAIN_METRICS = {
    "progress/update_step",
    "progress/tokens_seen",
    "progress/data_pass_equivalent",
    "train/loss",
    "train/lr",
    "train/grad_norm",
    "train/grad_norm_max",
    "train/clip_fraction",
    "perf/tokens_per_sec",
    "perf/step_time_ms",
}
EVAL_METRICS = {"eval/val_loss", "eval/train_loss"}
SUMMARY_KEYS = {
    "final_val_loss",
    "min_val_loss",
    "tokens_at_min_val_loss",
    "final_train_eval_loss",
    "final_val_perplexity",
    "final_tokens_seen",
    "final_data_pass_equivalent",
    "completed_target_budget",
    "optimizer_updates_completed",
    "skipped_updates_total",
    "wall_time_hours",
    "mean_tokens_per_sec",
    "peak_gpu_memory_allocated_gb",
    "peak_gpu_memory_reserved_gb",
    "stop_reason",
}


def run(*command: str) -> None:
    subprocess.run(command, check=True)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Run and verify the TinyStories GPU and W&B smoke test."
    )
    parser.parse_args()

    environment = load_environment_config()
    wandb_config = environment["wandb"]
    if wandb_config["mode"] != "online" or not wandb_config["enabled"]:
        raise RuntimeError("The smoke test requires W&B online mode")
    if export_wandb_key(wandb_config.get("key_source", "none")) == "none":
        raise RuntimeError("The smoke test requires a configured W&B API key")
    run_dir = Path(environment["runs_root"]) / RUN_NAME
    if run_dir.exists():
        raise FileExistsError(f"Smoke run already exists: {run_dir}")
    run("dmpod-prepare-data", "tinystories_smoke")
    run("dmpod-create-training", "--profile", "smoke-tinystories")
    run("dmpod-train", RUN_NAME)
    run("dmpod-export-run", RUN_NAME, "--format", "all")

    records = [
        json.loads(line)
        for line in (run_dir / "metrics.jsonl").read_text(encoding="utf-8").splitlines()
        if line.strip()
    ]
    local_keys = set().union(*(record.keys() for record in records))
    missing_metrics = (TRAIN_METRICS | EVAL_METRICS) - local_keys
    if missing_metrics:
        raise RuntimeError(f"Missing local metrics: {sorted(missing_metrics)}")
    summary = json.loads((run_dir / "summary.json").read_text(encoding="utf-8"))
    missing_summary = SUMMARY_KEYS - summary.keys()
    if missing_summary:
        raise RuntimeError(f"Missing summary values: {sorted(missing_summary)}")
    if summary["stop_reason"] != "completed" or not summary["completed_target_budget"]:
        raise RuntimeError("Smoke training did not complete its target budget")
    artifacts = json.loads((run_dir / "artifacts.json").read_text(encoding="utf-8"))
    aliases = {
        alias
        for checkpoint in artifacts["checkpoints"]
        for alias in checkpoint["aliases"]
    }
    required_aliases = {"latest", "best-val", "pass-1", "pass-2", "pass-4", "pass-8", "final"}
    if not required_aliases <= aliases:
        raise RuntimeError(f"Missing checkpoint aliases: {sorted(required_aliases - aliases)}")
    for path in (
        run_dir / "checkpoints" / "ckpt-final.pt",
        run_dir / "reports" / "README.md",
        run_dir / "reports" / "PR_BODY.md",
        run_dir / "reports" / "report-context.json",
    ):
        if not path.is_file():
            raise FileNotFoundError(path)

    wandb_record = json.loads((run_dir / "wandb.json").read_text(encoding="utf-8"))
    if wandb_record.get("mode") != "online" or not wandb_record.get("url"):
        raise RuntimeError("Smoke run did not record an online W&B URL")
    import wandb

    api = wandb.Api(timeout=60)
    path = f"{wandb_record['entity']}/{wandb_record['project']}/{wandb_record['run_id']}"
    remote = None
    for attempt in range(12):
        try:
            remote = api.run(path)
            if remote.state == "finished":
                break
        except Exception:
            if attempt == 11:
                raise
        time.sleep(5)
    if remote is None or remote.state != "finished":
        raise RuntimeError("W&B run did not reach the finished state")
    remote_config = dict(remote.config)
    for key in ("max_lr", "effective_batch_tokens", "seed", "actual_parameters_trainable"):
        if key not in remote_config:
            raise RuntimeError(f"Missing W&B config field: {key}")
    remote_summary = dict(remote.summary)
    for key in ("final_val_loss", "min_val_loss", "stop_reason"):
        if key not in remote_summary:
            raise RuntimeError(f"Missing W&B summary field: {key}")
    history_keys: set[str] = set()
    for row in remote.scan_history(page_size=1000):
        history_keys.update(key for key, value in row.items() if value is not None)
    missing_remote = (TRAIN_METRICS | EVAL_METRICS) - history_keys
    if missing_remote:
        raise RuntimeError(f"Missing W&B history metrics: {sorted(missing_remote)}")
    verification = {
        "version": 1,
        "status": "passed",
        "run": RUN_NAME,
        "wandb_url": wandb_record["url"],
        "local_metric_keys": sorted(local_keys),
        "wandb_history_keys": sorted(history_keys),
        "checkpoint_aliases": sorted(aliases),
        "summary": summary,
    }
    atomic_json(run_dir / "verification.json", verification)
    print(json.dumps(verification, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
