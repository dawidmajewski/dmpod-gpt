#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from dmpod_common import (  # noqa: E402
    config_path,
    load_environment_config,
    verify_configured_wandb,
)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Verify the effective DMPod Weights & Biases configuration."
    )
    parser.add_argument("--timeout", type=int, default=30)
    args = parser.parse_args()
    if args.timeout < 1:
        parser.error("--timeout must be positive")

    try:
        environment = load_environment_config()
    except FileNotFoundError:
        raise SystemExit(f"W&B status: not configured; run dmpod-setup ({config_path()})")
    wandb = environment.get("wandb", {})
    mode = str(wandb.get("mode", "disabled"))
    if not wandb.get("enabled") or mode == "disabled":
        raise SystemExit("W&B status: disabled in DMPod configuration")
    if mode != "online":
        raise SystemExit(f"W&B status: {mode}; online logging is not connected")

    try:
        source, account_entity = verify_configured_wandb(wandb, timeout=args.timeout)
    except RuntimeError as error:
        raise SystemExit(f"W&B status: unavailable; {error}") from None

    print("W&B status: connected")
    print(f"Mode: {mode}")
    print(f"Project: {wandb.get('project', '')}")
    print(f"Entity: {wandb.get('entity') or account_entity}")
    print(f"Key source: {source}")


if __name__ == "__main__":
    main()
