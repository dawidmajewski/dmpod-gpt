#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from dmpod_common import (  # noqa: E402
    atomic_json,
    load_environment_config,
    load_json,
    state_root,
    verify_configured_wandb,
)
from dmpod_profile import load_profile  # noqa: E402
from dmpod_wandb import DASHBOARD_SECTIONS, PRIMARY_X_AXIS  # noqa: E402


def main() -> None:
    parser = argparse.ArgumentParser(description="Create the canonical W&B workspace.")
    parser.add_argument("name", nargs="?", help="Saved run whose frozen project to use")
    parser.add_argument(
        "--profile", help="Profile project to use when no run exists yet"
    )
    args = parser.parse_args()
    if args.name and args.profile:
        parser.error("NAME cannot be combined with --profile")
    environment = load_environment_config()
    wandb = environment["wandb"]
    if wandb["mode"] != "online" or not wandb["enabled"]:
        raise RuntimeError("W&B dashboard creation requires online mode")
    verify_configured_wandb(wandb)
    if not wandb.get("entity"):
        raise RuntimeError("Run dmpod-setup with --wandb-entity first")
    os.environ["WANDB_ENTITY"] = wandb["entity"]
    if args.name:
        config = load_json(Path(environment["runs_root"]) / args.name / "config.json")
        project = config["wandb"]["project"]
    else:
        _, profile = load_profile(args.profile or "minimal-en-125m")
        project = profile["wandb"]["project"]
    import wandb_workspaces.reports.v2 as wr
    import wandb_workspaces.workspaces as ws

    state_path = state_root() / "wandb-workspaces.json"
    state = (
        json.loads(state_path.read_text(encoding="utf-8"))
        if state_path.is_file()
        else {"version": 1, "projects": {}}
    )
    sections = [
        ws.Section(
            name=definition["name"],
            is_open=True,
            panels=[
                wr.LinePlot(title=title, x=PRIMARY_X_AXIS, y=list(metrics))
                for title, metrics in definition["panels"]
            ],
        )
        for definition in DASHBOARD_SECTIONS
    ]
    key = f"{wandb['entity']}/{project}"
    existing_url = state["projects"].get(key)
    if existing_url:
        workspace = ws.Workspace.from_url(existing_url)
        workspace.sections = sections
        workspace.save()
    else:
        workspace = ws.Workspace(
            name=f"nanoGPT Training - {project}",
            entity=wandb["entity"],
            project=project,
            sections=sections,
        )
        workspace.save()
        state["projects"][key] = workspace.url
        atomic_json(state_path, state, mode=0o600)
    print(f"W&B workspace ready: {workspace.url}")


if __name__ == "__main__":
    main()
