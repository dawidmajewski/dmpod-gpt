{
  "category": "NVIDIA",
  "containerDiskInGb": 30,
  "dockerEntrypoint": [],
  "dockerStartCmd": [],
  "env": {
    "HF_HOME": "/workspace/cache/huggingface",
    "HF_HUB_CACHE": "/workspace/cache/huggingface/hub",
    "TORCH_HOME": "/workspace/cache/torch",
    "WANDB_DIR": "/workspace/logs/wandb"
  },
  "imageName": "dawidmkrk/dmpod-gpt:v1.0.0",
  "isPublic": false,
  "isServerless": false,
  "name": "dmpod-gpt-v1",
  "ports": ["8888/http", "22/tcp"],
  "readme": "Persistent nanoGPT environment. Attach storage at /workspace, run dmpod-setup, then prepare data and create a named training run. Codex and Claude Code are installed but authentication is user-managed.",
  "volumeInGb": 50,
  "volumeMountPath": "/workspace"
}
